<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={gettext("Media")}
  page_subtitle={gettext("Manage user media and uploads")}
  current_path={@url_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="flex flex-col w-full h-[calc(100dvh-4rem)]">
    <%!-- The library switcher: only once there is more than one library (site or
         the viewer's own). With one, the page says nothing about libraries. --%>
    <form
      :if={library_count(@libraries, @my_libraries) > 1}
      id="media-library-switcher"
      phx-change="switch_library"
      class="flex items-center gap-2 px-4 pb-2"
    >
      <label for="media-library-select" class="text-sm text-base-content/70">
        {gettext("Library")}
      </label>
      <select id="media-library-select" name="library" class="select select-sm">
        <optgroup :if={@my_libraries != []} label={gettext("Site")}>
          <option
            :for={library <- @libraries}
            value={library.slug || ""}
            selected={(@library && is_nil(@role)) and library.uuid == @library.uuid}
          >
            {library.name}
          </option>
        </optgroup>
        <%!-- With no library of the viewer's own, the site ones need no heading. --%>
        <%= if @my_libraries == [] do %>
          <option
            :for={library <- @libraries}
            value={library.slug || ""}
            selected={@library && library.uuid == @library.uuid}
          >
            {library.name}
          </option>
        <% end %>
        <optgroup :if={@my_libraries != []} label={gettext("Mine")}>
          <option
            :for={%{library: library} <- @my_libraries}
            value={"my:" <> Libraries.url_id(library, @phoenix_kit_current_user.uuid)}
            selected={(@library && @role != nil) and library.uuid == @library.uuid}
          >
            {library.name}
          </option>
        </optgroup>
      </select>
    </form>

    <.live_component
      module={PhoenixKitWeb.Components.MediaBrowser}
      id="media-browser"
      library_uuid={PhoenixKitWeb.Live.Users.Media.browser_library_uuid(@libraries, @library)}
      viewer_uuid={@viewer_uuid}
      readonly={readonly?(@role)}
      own_files_only={@viewer_uuid || own_files_only(@role, @phoenix_kit_current_user)}
      phoenix_kit_current_user={assigns[:phoenix_kit_current_user]}
      admin={true}
      fill_height={true}
      on_navigate={:navigate}
      initial_params={@initial_params}
      parent_uploads={@uploads}
    />
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
