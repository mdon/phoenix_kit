<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@current_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="px-4 py-6">
    <.nav_tabs
      active_tab={@active_tab}
      on_change="switch_settings_tab"
      variant={:border}
      tabs={[
        %{id: "company", label: gettext("Company Information"), icon: "hero-building-office-2"},
        %{id: "countries", label: gettext("Main countries"), icon: "hero-map-pin"},
        %{id: "bank", label: gettext("Bank Accounts"), icon: "hero-building-library"},
        %{id: "tax", label: gettext("Tax Settings"), icon: "hero-receipt-percent"},
        %{id: "site_url", label: gettext("Site URL"), icon: "hero-globe-alt"}
      ]}
      class="mb-6"
    />

    <div class={if @active_tab != "company", do: "hidden"}>
      <%!-- Company Information --%>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body gap-0.5">
          <h2 class="card-title">
            <.icon name="hero-building-office-2" class="w-5 h-5" />
            {gettext("Company Information")}
          </h2>
          <p class="text-sm text-base-content/60 flex-none">
            {gettext("Used in legal documents and invoices")}
          </p>

          <form phx-submit="save_company" class="space-y-4">
            <%!-- Row: Company Name + Country --%>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="fieldset">
                <.input
                  type="text"
                  name="company_name"
                  value={@company_name}
                  label={gettext("Company Name")}
                  placeholder={gettext("Your Company Name")}
                  required
                />
              </div>

              <div class="fieldset">
                <.select
                  name="company_country"
                  value={@company_country}
                  phx-change="country_changed"
                  required
                  label={gettext("Country")}
                  prompt={gettext("Select country...")}
                  options={@countries}
                />
              </div>
            </div>

            <div class="divider text-xs">{gettext("Address")}</div>

            <%!-- Row: Street Address --%>
            <div class="fieldset">
              <.input
                type="text"
                name="company_address_line1"
                value={@company_address_line1}
                label={gettext("Street Address")}
                placeholder={gettext("123 Business Street")}
                required
              />
            </div>

            <%!-- Row: Address Line 2 --%>
            <div class="fieldset">
              <.input
                type="text"
                name="company_address_line2"
                value={@company_address_line2}
                label={gettext("Address Line 2")}
                placeholder={gettext("Suite, Floor, Building (optional)")}
              />
            </div>

            <%!-- Row: City + State/Province + Postal Code --%>
            <div class="grid grid-cols-3 gap-4">
              <div class="fieldset">
                <.input
                  type="text"
                  name="company_city"
                  value={@company_city}
                  label={gettext("City")}
                  placeholder={gettext("City")}
                  required
                />
              </div>

              <div class="fieldset">
                <%= if @subdivisions != [] do %>
                  <.select
                    name="company_state"
                    value={@company_state}
                    label={@subdivision_label}
                    prompt={gettext("Select...")}
                    options={@subdivisions}
                  />
                <% else %>
                  <.input
                    type="text"
                    name="company_state"
                    value={@company_state}
                    label={@subdivision_label}
                    placeholder={gettext("(optional)")}
                  />
                <% end %>
              </div>

              <div class="fieldset">
                <.input
                  type="text"
                  name="company_postal_code"
                  value={@company_postal_code}
                  label={@postal_code_label}
                  placeholder={postal_code_placeholder(@company_country)}
                  class="font-mono"
                />
              </div>
            </div>

            <div class="divider text-xs">{gettext("Tax & Registration")}</div>

            <%!-- Row: VAT Number + Registration Number --%>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="fieldset">
                <.input
                  type="text"
                  name="company_vat"
                  value={@company_vat}
                  label={@tax_id_label}
                  placeholder={tax_id_placeholder(@company_country, @eu_country)}
                  required
                  class="font-mono"
                />
                <%= if @eu_country do %>
                  <label class="label">
                    <span class="fieldset-label text-info">
                      <.icon name="hero-information-circle" class="w-4 h-4 inline" />
                      {gettext("EU format: %{country}123456789", country: @company_country)}
                    </span>
                  </label>
                <% end %>
                <%= if @company_country == "US" do %>
                  <label class="label">
                    <span class="fieldset-label text-info">
                      <.icon name="hero-information-circle" class="w-4 h-4 inline" />
                      {gettext("EIN format: 12-3456789")}
                    </span>
                  </label>
                <% end %>
                <%= if @company_country == "CA" do %>
                  <label class="label">
                    <span class="fieldset-label text-info">
                      <.icon name="hero-information-circle" class="w-4 h-4 inline" />
                      {gettext(
                        "Business Number, optionally with a program account, e.g. 123456789RT0001"
                      )}
                    </span>
                  </label>
                <% end %>
              </div>

              <div class="fieldset">
                <.input
                  type="text"
                  name="company_registration"
                  value={@company_registration}
                  label={gettext("Registration Number")}
                  placeholder={gettext("Business reg. number (optional)")}
                  class="font-mono"
                />
              </div>
            </div>

            <div class="card-actions justify-end mt-4">
              <button type="submit" class="btn btn-primary">
                <.icon name="hero-check" class="w-4 h-4" />
                {gettext("Save Company Info")}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class={if @active_tab != "countries", do: "hidden"}>
      <%!-- Main countries --%>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">
            <.icon name="hero-map-pin" class="w-5 h-5" />
            {gettext("Main countries")}
          </h2>
          <p class="text-sm text-base-content/60">
            {gettext("Shown at the top of every country list. Drag to reorder.")}
          </p>

          <%= if @main_country_rows == [] do %>
            <p class="text-sm text-base-content/50 mt-4">
              {gettext("Nothing chosen yet — country lists are plain alphabetical.")}
            </p>
          <% else %>
            <.draggable_list
              id="main-countries"
              items={@main_country_rows}
              item_id={& &1.code}
              on_reorder="reorder_main_countries"
              layout={:list}
              gap="gap-1"
              class="mt-4"
              sortable_handle=".pk-drag-handle"
              item_class="flex items-center gap-2 py-2 px-1 rounded-lg hover:bg-base-200"
            >
              <:item :let={row}>
                <.icon
                  name="hero-bars-3"
                  class="pk-drag-handle w-4 h-4 shrink-0 text-base-content/40 cursor-grab active:cursor-grabbing"
                />
                <span class="grow truncate">{row.label}</span>
                <button
                  type="button"
                  phx-click="move_main_country"
                  phx-value-code={row.code}
                  phx-value-direction="up"
                  class="btn btn-ghost btn-xs"
                  disabled={row.first?}
                  aria-label={gettext("Move up")}
                >
                  <.icon name="hero-chevron-up" class="w-4 h-4" />
                </button>
                <button
                  type="button"
                  phx-click="move_main_country"
                  phx-value-code={row.code}
                  phx-value-direction="down"
                  class="btn btn-ghost btn-xs"
                  disabled={row.last?}
                  aria-label={gettext("Move down")}
                >
                  <.icon name="hero-chevron-down" class="w-4 h-4" />
                </button>
                <button
                  type="button"
                  phx-click="remove_main_country"
                  phx-value-code={row.code}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label={gettext("Remove")}
                >
                  <.icon name="hero-x-mark" class="w-4 h-4" />
                </button>
              </:item>
            </.draggable_list>
          <% end %>

          <%= if @main_country_suggestion != [] do %>
            <div class="alert alert-info mt-4 flex-col items-start gap-2">
              <span class="text-sm">
                {gettext("Based on your country: %{countries}",
                  countries:
                    Enum.map_join(@main_country_suggestion, ", ", fn suggested ->
                      suggested.label
                    end)
                )}
              </span>
              <button type="button" phx-click="apply_main_country_suggestion" class="btn btn-sm">
                <.icon name="hero-plus" class="w-4 h-4" />
                {gettext("Add these")}
              </button>
            </div>
          <% end %>

          <form
            id="main-countries-add"
            phx-submit="add_main_country"
            class="flex items-end gap-2 mt-4"
          >
            <div class="grow">
              <%!-- The id carries the current count so the picker remounts
                     (and clears its own selection) after every add. --%>
              <.live_component
                module={PhoenixKitWeb.Live.Components.SearchableSelect}
                id={"main-country-picker-#{length(@main_country_rows)}"}
                name="code"
                value=""
                options={@main_country_options}
                label={gettext("Add a country")}
                placeholder={gettext("Search countries...")}
              />
            </div>
            <button type="submit" class="btn btn-primary">
              <.icon name="hero-plus" class="w-4 h-4" />
              {gettext("Add")}
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class={if @active_tab != "bank", do: "hidden"}>
      <%!-- Bank Accounts --%>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="card-title">
                <.icon name="hero-building-library" class="w-5 h-5" />
                {gettext("Bank Accounts")}
              </h2>
              <p class="text-sm text-base-content/60">
                {gettext(
                  "For bank transfer payments on invoices. A company can have more than one."
                )}
              </p>
            </div>
            <button
              type="button"
              class="btn btn-primary btn-sm shrink-0"
              phx-click="show_add_bank_account_form"
            >
              <.icon name="hero-plus" class="w-4 h-4" /> {gettext("Add Bank Account")}
            </button>
          </div>

          <%= if @bank_accounts == [] do %>
            <div class="text-center py-8 border border-dashed border-base-300 rounded-lg mt-4">
              <.icon
                name="hero-building-library"
                class="w-10 h-10 mx-auto mb-4 text-base-content/30"
              />
              <p class="text-base-content/60">
                {gettext("No bank accounts added yet")}
              </p>
            </div>
          <% else %>
            <div class="space-y-2 mt-4">
              <div
                :for={account <- @bank_accounts}
                class="flex items-center justify-between gap-3 p-3 rounded-lg border border-base-300"
              >
                <div class="min-w-0">
                  <div class="font-medium text-sm flex items-center gap-2">
                    {account["label"]}
                    <span :if={account["primary"]} class="badge badge-primary badge-sm">
                      {gettext("Primary")}
                    </span>
                  </div>
                  <div class="text-xs text-base-content/60 truncate">
                    {account["bank_name"]}
                    <span :if={account["iban"] != ""}>· {account["iban"]}</span>
                    <span :if={account["swift"] != ""}>· {account["swift"]}</span>
                  </div>
                </div>
                <div class="flex gap-1 shrink-0">
                  <button
                    type="button"
                    class="btn btn-xs btn-ghost"
                    phx-click="show_edit_bank_account_form"
                    phx-value-uuid={account["uuid"]}
                  >
                    <.icon name="hero-pencil" class="w-3 h-3" /> {gettext("Edit")}
                  </button>
                  <button
                    type="button"
                    class="btn btn-xs btn-ghost text-error"
                    phx-click="delete_bank_account"
                    phx-value-uuid={account["uuid"]}
                    data-confirm={gettext("Remove this bank account?")}
                  >
                    <.icon name="hero-trash" class="w-3 h-3" /> {gettext("Remove")}
                  </button>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Bank Account Form Modal (outside the tab panes so it doesn't get
         hidden if the operator switches tabs while it's open) --%>
    <%= if @show_bank_account_form do %>
      <div class="modal modal-open">
        <div class="modal-box max-w-lg">
          <h3 class="font-bold text-lg mb-4">
            {if @editing_bank_account,
              do: gettext("Edit Bank Account"),
              else: gettext("Add Bank Account")}
          </h3>

          <.form
            :let={_f}
            for={%{}}
            id="bank-account-form"
            phx-submit="save_bank_account"
            class="space-y-4"
          >
            <div class="fieldset">
              <label class="label">
                <span class="fieldset-legend">{gettext("Label")}</span>
              </label>
              <.input
                type="text"
                name="account_label"
                value={@editing_bank_account && @editing_bank_account["label"]}
                placeholder={gettext("e.g. EUR operations, USD reserve")}
              />
            </div>

            <div class="fieldset">
              <label class="label">
                <span class="fieldset-legend">{gettext("Bank Name")}</span>
              </label>
              <.input
                type="text"
                name="bank_name"
                value={@editing_bank_account && @editing_bank_account["bank_name"]}
                placeholder={gettext("Bank Name")}
                required
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="fieldset sm:col-span-2">
                <label class="label">
                  <span class="fieldset-legend">{gettext("IBAN")}</span>
                </label>
                <.input
                  type="text"
                  name="iban"
                  value={@editing_bank_account && @editing_bank_account["iban"]}
                  placeholder="EE00 0000 0000 0000 0000"
                  class="font-mono"
                />
              </div>

              <div class="fieldset">
                <label class="label">
                  <span class="fieldset-legend">{gettext("SWIFT/BIC")}</span>
                </label>
                <.input
                  type="text"
                  name="swift"
                  value={@editing_bank_account && @editing_bank_account["swift"]}
                  placeholder="XXXXEEHH"
                  class="font-mono"
                />
              </div>
            </div>

            <div class="fieldset">
              <.checkbox
                name="primary"
                checked={@editing_bank_account && @editing_bank_account["primary"]}
                label={gettext("Primary account")}
              >
                <:description>
                  {gettext(
                    "Shown first on invoices and documents. Making this one primary un-sets any other."
                  )}
                </:description>
              </.checkbox>
            </div>

            <div class="modal-action">
              <button type="submit" class="btn btn-primary">
                {if @editing_bank_account,
                  do: gettext("Save Changes"),
                  else: gettext("Add Account")}
              </button>
              <button type="button" class="btn" phx-click="hide_bank_account_form">
                {gettext("Cancel")}
              </button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <div class={if @active_tab != "tax", do: "hidden"}>
      <%!-- Tax Settings --%>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title">
            <.icon name="hero-receipt-percent" class="w-5 h-5" />
            {gettext("Tax Settings")}
          </h2>
          <p class="text-sm text-base-content/60">
            {gettext("Default tax rate applied across Billing and Shop modules")}
          </p>

          <form phx-submit="save_tax" class="space-y-4 mt-4">
            <%!-- Row: Enable Tax + Tax Rate --%>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-end">
              <div class="fieldset">
                <.checkbox name="tax_enabled" checked={@tax_enabled}>
                  <span class="font-medium">{gettext("Enable Tax")}</span>
                </.checkbox>
              </div>

              <div class="fieldset">
                <label class="label">
                  <span class="fieldset-legend">{gettext("Default Tax Rate")}</span>
                </label>
                <div class="join">
                  <.input
                    type="number"
                    name="tax_rate"
                    value={@tax_rate}
                    min="0"
                    max="100"
                    step="0.01"
                    class="join-item w-24 font-mono"
                    wrapper_class="contents"
                    phx-change="tax_rate_changed"
                    phx-debounce="300"
                  />
                  <span class="btn btn-disabled join-item">%</span>
                </div>
              </div>
            </div>

            <%= if @suggested_tax_rate do %>
              <div class="alert alert-info py-2">
                <.icon name="hero-light-bulb" class="w-4 h-4" />
                <span class="text-sm">
                  {gettext("Standard rate for your country: %{rate}%",
                    rate: @suggested_tax_rate
                  )}
                </span>
                <button
                  type="button"
                  phx-click="apply_suggested_tax"
                  class="btn btn-xs btn-primary"
                >
                  {gettext("Apply")}
                </button>
              </div>
            <% end %>

            <div class="card-actions justify-end mt-4">
              <button type="submit" class="btn btn-primary">
                <.icon name="hero-check" class="w-4 h-4" />
                {gettext("Save Tax Settings")}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class={if @active_tab != "site_url", do: "hidden"}>
      <%!-- Site URL (from General Settings) --%>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <h2 class="card-title">
              <.icon name="hero-globe-alt" class="w-5 h-5" />
              {gettext("Site URL")}
            </h2>
            <.link
              navigate={
                PhoenixKit.Utils.Routes.path("/admin/settings", locale: @current_locale_base)
              }
              class="btn btn-sm btn-primary"
            >
              <.icon name="hero-pencil-square" class="w-4 h-4" />
              {gettext("Edit in General")}
            </.link>
          </div>
          <p class="text-sm text-base-content/60">
            {gettext("Used in legal documents and sitemap generation")}
          </p>

          <div class="bg-base-200 rounded-lg p-4 mt-4">
            <%= if @site_url != "" do %>
              <div class="flex items-center gap-2">
                <.icon name="hero-globe-alt" class="w-5 h-5 text-primary" />
                <a href={@site_url} target="_blank" class="link link-primary">
                  {@site_url}
                </a>
              </div>
            <% else %>
              <div class="flex items-center gap-2 text-base-content/60">
                <.icon name="hero-globe-alt" class="w-5 h-5" />
                <span class="italic">{gettext("Not configured")}</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- Info Alert --%>
    <div class="alert alert-info mt-6">
      <.icon name="hero-information-circle" class="w-6 h-6" />
      <div>
        <p class="font-semibold">{gettext("Shared across modules")}</p>
        <p class="text-sm">
          {gettext(
            "Company info, tax settings, and bank details are shared across Legal, Billing, and Shop modules."
          )}
        </p>
      </div>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
