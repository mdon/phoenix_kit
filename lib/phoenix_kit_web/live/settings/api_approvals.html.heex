<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  page_subtitle={@page_subtitle}
  page_section={@page_section}
  page_section_path={@page_section_path}
  current_path={@current_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div id="api-approvals-page" class="px-4 py-6 space-y-6">
    <div id="api-approvals-pending" class="space-y-4">
      <div
        :for={%{approval: approval, key: key, view: preview} <- @pending}
        id={"approval-#{approval.uuid}"}
        class="card bg-base-100 shadow-lg border border-base-200"
      >
        <div class="card-body space-y-3">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="space-y-1">
              <div class="font-mono text-sm font-semibold">{approval.tool}</div>
              <div class="text-sm text-base-content/70">
                {gettext("Key: %{name}", name: key.name)}
                <span class="font-mono text-xs text-base-content/60">pk_{key.prefix}_…</span>
              </div>
              <div class="text-xs text-base-content/60">
                {gettext("Requested")}
                <.time_ago datetime={approval.inserted_at} id={"approval-asked-#{approval.uuid}"} />
                · {gettext("Expires")}
                <.time_ago
                  datetime={approval.expires_at}
                  id={"approval-expires-#{approval.uuid}"}
                />
              </div>
            </div>

            <div class="flex gap-2">
              <.button
                id={"reject-#{approval.uuid}"}
                type="button"
                variant="outline"
                size="sm"
                phx-click="reject"
                phx-value-uuid={approval.uuid}
                disabled={@busy != nil}
              >
                {gettext("Reject")}
              </.button>
              <.button
                id={"approve-#{approval.uuid}"}
                type="button"
                size="sm"
                phx-click="approve"
                phx-value-uuid={approval.uuid}
                data-confirm={
                  preview.hidden > 0 &&
                    gettext("Approve the whole operation? Only part of its preview is shown.")
                }
                disabled={@busy != nil}
              >
                <span :if={@busy == approval.uuid} class="loading loading-spinner loading-xs"></span>
                {gettext("Approve")}
              </.button>
            </div>
          </div>

          <div id={"approval-preview-#{approval.uuid}"} class="space-y-2">
            <div class="text-sm font-medium">{gettext("What would change")}</div>

            <div
              :if={preview.totals != nil}
              id={"approval-totals-#{approval.uuid}"}
              class="rounded bg-base-200 p-3"
            >
              <div class="text-xs font-medium uppercase text-base-content/60">
                {gettext("Summary")}
              </div>
              <pre class="mt-1 whitespace-pre-wrap text-xs">{json_text(preview.totals)}</pre>
            </div>

            <pre
              :if={preview.rows != []}
              id={"approval-rows-#{approval.uuid}"}
              class="max-h-72 overflow-auto rounded bg-base-200 p-3 text-xs"
            >{json_text(preview.rows)}</pre>

            <pre
              :if={preview.other != %{}}
              id={"approval-other-#{approval.uuid}"}
              class="max-h-40 overflow-auto rounded bg-base-200 p-3 text-xs"
            >{json_text(preview.other)}</pre>

            <div
              :if={preview.hidden > 0}
              id={"approval-truncated-#{approval.uuid}"}
              role="alert"
              class="alert alert-warning text-sm"
            >
              <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
              <span>
                {gettext(
                  "The preview is cut: %{count} rows are not shown. Approving runs the whole operation, not only the rows shown.",
                  count: preview.hidden
                )}
              </span>
            </div>
          </div>
        </div>
      </div>

      <div :if={@pending == []} id="approvals-empty">
        <.empty_state
          variant="compact"
          icon="hero-shield-check"
          title={gettext("Nothing is waiting for approval.")}
          description={gettext("Operations that need your approval will show up here.")}
        />
      </div>
    </div>

    <div
      :if={@recent != []}
      id="api-approvals-recent"
      class="card bg-base-100 shadow-lg border border-base-200"
    >
      <div class="card-body space-y-3">
        <h2 class="card-title text-lg">
          <.icon name="hero-clock" class="w-5 h-5" /> {gettext("Recently decided")}
        </h2>

        <.table_default>
          <.table_default_header>
            <.table_default_row>
              <.table_default_header_cell>{gettext("Tool")}</.table_default_header_cell>
              <.table_default_header_cell>{gettext("Key")}</.table_default_header_cell>
              <.table_default_header_cell>{gettext("Status")}</.table_default_header_cell>
              <.table_default_header_cell>{gettext("Decided")}</.table_default_header_cell>
            </.table_default_row>
          </.table_default_header>

          <.table_default_body>
            <.table_default_row
              :for={%{approval: approval, key: key} <- @recent}
              id={"recent-#{approval.uuid}"}
            >
              <.table_default_cell class="font-mono text-sm">{approval.tool}</.table_default_cell>
              <.table_default_cell class="text-sm">{key.name}</.table_default_cell>
              <.table_default_cell>
                <span class={["badge badge-sm", status_class(approval.status)]}>
                  {status_label(approval.status)}
                </span>
              </.table_default_cell>
              <.table_default_cell>
                <.time_ago datetime={approval.updated_at} id={"recent-when-#{approval.uuid}"} />
              </.table_default_cell>
            </.table_default_row>
          </.table_default_body>
        </.table_default>
      </div>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
